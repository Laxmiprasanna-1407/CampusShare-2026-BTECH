# ==============================================================================
# CampusShare: Peer-to-Peer College Item Rental Platform - Environment Config
# ==============================================================================
# NOTE: Safe defaults are provided below for immediate local running.
# CRITICAL SECURITY WARNING:
# JWT_SECRET and ADMIN_PASSWORD MUST be changed to strong, unique values
# before any public production deployment!
# ==============================================================================

# Spring Profile ('local' for H2 file database, 'docker' for MySQL container, 'prod' for external MySQL)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Security - JWT Configuration
# In 'prod' profile, the server will refuse to start if secret is under 32 characters or default!
JWT_SECRET=campusshare_jwt_super_secure_secret_key_2026_capstone_must_be_long_enough_256bit
JWT_EXPIRATION_MS=86400000

# Initial Admin Seeding (Seeded automatically on startup if account does not exist)
ADMIN_EMAIL=admin@campusshare.edu
ADMIN_PASSWORD=Admin@Campus2026!
ADMIN_NAME=Campus Administrator

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Used when profile is 'docker' or 'prod')
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusshare
DB_USERNAME=campus_user
DB_PASSWORD=campus_secret_2026

# AI Chatbot Configuration (Optional LLM Integration)
# Leave LLM_API_KEY empty to use the built-in database RAG search fallback without external charges.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT_MS=10000
LLM_MAX_CONTEXT_ITEMS=6

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
